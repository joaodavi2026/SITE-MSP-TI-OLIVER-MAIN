# ------------------------------------------------------------------
# Oliver Network — variáveis de ambiente
# ------------------------------------------------------------------
# 1. Copie este arquivo:            cp .env.example .env.local
# 2. Preencha os valores abaixo
# 3. Rode o projeto:                npm run dev
#
# NUNCA faça commit do .env.local nem exponha a chave no frontend.
# NÃO use NEXT_PUBLIC_ANTHROPIC_API_KEY — a chave só pode viver no servidor.
# ------------------------------------------------------------------

# Chave da API da Anthropic (obrigatória para o assistente Oliver IA).
# Sem ela, o chat responde com uma mensagem orientando o contato humano.
ANTHROPIC_API_KEY=

# Opcional — modelo usado pelo assistente. Padrão: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# Opcional — URL pública do site (usada em metadata/SEO). Padrão: https://olivernetwork.com.br
# NEXT_PUBLIC_APP_URL=https://olivernetwork.com.br
